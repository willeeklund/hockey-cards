# Image storage backend used by the dev server's /api/upload + /api/save-crop
# middleware. "local" writes to public/exercise_images/<team>/; "blob" writes
# to Azure Blob Storage.
#
# Teams are now chosen from the UI (dropdown in the toolbar) — edit
# src/config/teams.ts to add more.
STORAGE_BACKEND=local

# Only needed when STORAGE_BACKEND=blob (e.g. for testing the cloud path
# locally with `az login`):
# STORAGE_ACCOUNT=stgotaofficeprod
# STORAGE_CONTAINER=files
