{
  "name": "gota-off-ice-cards",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/generate-openapi.mjs && vite",
    "build": "node scripts/generate-openapi.mjs && vite build && tsc -p tsconfig.server.json",
    "build:server": "tsc -p tsconfig.server.json",
    "openapi": "node scripts/generate-openapi.mjs",
    "preview": "vite preview",
    "start": "node dist/server/index.js",
    "typecheck": "tsc --build",
    "test": "vitest run",
    "tunnel": "npx localtunnel --port 3000"
  },
  "dependencies": {
    "@azure/identity": "^4.5.0",
    "@azure/storage-blob": "^12.26.0",
    "@microsoft/applicationinsights-web": "^3.3.0",
    "express": "^4.21.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.7.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@vitejs/plugin-react": "^5.0.0",
    "js-yaml": "^4.1.0",
    "swagger-jsdoc": "^6.2.8",
    "typescript": "^5.6.0",
    "vite": "^8.0.12",
    "vitest": "^4.1.2"
  }
}
